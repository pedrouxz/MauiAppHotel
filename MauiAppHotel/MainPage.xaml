<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.MainPage"
             Title="App Hotel">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sobre" Clicked="OnSobreClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Cálculo da Diária" FontSize="32" FontAttributes="Bold"
                   TextColor="#0F766E" HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="15">
                <Label Text="Adultos:" VerticalOptions="Center" FontSize="18" />
                <Label Grid.Column="1" VerticalOptions="Center" FontSize="18"
                       Text="{Binding Source={x:Reference stp_adultos}, Path=Value}" />
                <Stepper Grid.Column="2" x:Name="stp_adultos"
                         Minimum="1" Maximum="4" Increment="1" Value="1" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="15">
                <Label Text="Crianças:" VerticalOptions="Center" FontSize="18" />
                <Label Grid.Column="1" VerticalOptions="Center" FontSize="18"
                       Text="{Binding Source={x:Reference stp_criancas}, Path=Value}" />
                <Stepper Grid.Column="2" x:Name="stp_criancas"
                         Minimum="0" Maximum="4" Increment="1" Value="0" />
            </Grid>

            <Label Text="Escolha sua Suíte" FontSize="18" FontAttributes="Bold" />
            <Picker x:Name="pck_quarto" Title="Selecione sua Acomodação"
                    ItemDisplayBinding="{Binding Descricao}" />

            <Border Stroke="#0F766E" StrokeThickness="2" Padding="15"
                    BackgroundColor="{AppThemeBinding Light=#E6F7F5, Dark=#12302D}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Período da Estadia" FontSize="18" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="Check-in:" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" x:Name="dtp_checkin"
                                    Format="dd/MM/yyyy" DateSelected="OnCheckInSelected" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="Check-out:" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" x:Name="dtp_checkout"
                                    Format="dd/MM/yyyy" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Avançar" BackgroundColor="#0F766E" TextColor="White"
                    CornerRadius="10" Clicked="OnAvancarClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>