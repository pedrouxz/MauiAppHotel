<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.ContratoHospedagem"
             Title="Resumo da Reserva">
    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Resumo da Hospedagem" FontSize="24"
               FontAttributes="Bold" TextColor="#0F766E" />

        <Label Text="{Binding QuartoSelecionado.Descricao, StringFormat='Quarto: {0}'}" FontSize="18" />
        <Label Text="{Binding QtdAdultos, StringFormat='Adultos: {0}'}" FontSize="18" />
        <Label Text="{Binding QtdCriancas, StringFormat='Crianças: {0}'}" FontSize="18" />
        <Label Text="{Binding DataCheckIn, StringFormat='Check-in: {0:dd/MM/yyyy}'}" FontSize="18" />
        <Label Text="{Binding DataCheckOut, StringFormat='Check-out: {0:dd/MM/yyyy}'}" FontSize="18" />
        <Label Text="{Binding Estadia, StringFormat='Noites: {0}'}" FontSize="18" />
        <Label Text="{Binding ValorTotal, StringFormat='Valor total: {0:C}'}"
               FontSize="22" FontAttributes="Bold" TextColor="#0F766E" />

        <Button Text="Voltar" BackgroundColor="#0F766E" TextColor="White"
                CornerRadius="10" Clicked="OnVoltarClicked" />
    </VerticalStackLayout>
</ContentPage>