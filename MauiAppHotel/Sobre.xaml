<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Sobre"
             Title="Sobre">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Label Text="App Hotel" FontSize="28" FontAttributes="Bold"
               TextColor="#0F766E" HorizontalOptions="Center" />
        <Label Text="Desenvolvedor: Pedro Henrique Araujo" FontSize="18" />
        <Label Text="Ano de desenvolvimento: 2026" FontSize="18" />
        <Label Text="Curso Técnico em Desenvolvimento de Sistemas - Programação Mobile I" FontSize="14" />
        <Button Text="Voltar" BackgroundColor="#0F766E" TextColor="White"
                CornerRadius="10" Clicked="OnVoltarClicked" />
    </VerticalStackLayout>
</ContentPage>